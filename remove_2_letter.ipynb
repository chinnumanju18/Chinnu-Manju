      "source": [
        "def remove_letters(s):\n",
        "    if len(s) < 4:\n",
        "        return \"The string must have at least four characters.\"\n",
        "    result = s[2:-2]\n",
        "    return result\n",
        "s = input(\"Enter a string: \")\n",
        "print(remove_letters(s))"
      ]
    }
