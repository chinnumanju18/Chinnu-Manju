      "source": [
        "def filter_odd_length(words):\n",
        "    return [word for word in words if len(word) % 2 == 0]\n",
        "words = [\"apple\", \"banana\", \"cherry\", \"date\", \"fig\", \"grape\"]\n",
        "filtered_words = filter_odd_length(words)\n",
        "print(filtered_words)\n"
      ]
    }
  ]
